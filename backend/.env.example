API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_TEXT_CHARACTERS=5000
MAX_AUDIO_BYTES=10485760
MAX_IMAGE_BYTES=5242880
# SQLite by default so local development needs no services.
# Compose sets Postgres: postgresql+psycopg://reflect:reflect@db:5432/reflect
DATABASE_URL=sqlite:///./reflect.db
# Optional: choose a persistent location for pretrained model downloads.
# HF_HOME=/models/huggingface
# Whisper uses the Hugging Face cache for the local base.en checkpoint as well.
